{
  "name": "@notyra/plugin-api",
  "version": "3.1.7",
  "description": "Notyra plugin API types and manifest validation; runtime provided by the host",
  "type": "module",
  "license": "MIT",
  "author": "Yuma Shintani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuma-shin/notyra-plugin-api.git"
  },
  "homepage": "https://github.com/yuma-shin/notyra-plugin-api#readme",
  "bugs": {
    "url": "https://github.com/yuma-shin/notyra-plugin-api/issues"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "files": [
    "*.d.ts",
    "index.js",
    "types.js",
    "manifest.js",
    "api-source.json",
    "README.md",
    "LICENSE.md"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./manifest": {
      "types": "./manifest.d.ts",
      "import": "./manifest.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build && pnpm test"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@codemirror/language": "^6.13.1",
    "@codemirror/commands": "^6.11.1",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/semver": "7.8.0",
    "@types/node": "26.6.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
